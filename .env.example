# Copy to .env for local mock mode
APP_MODE=mock
USE_REAL_AWS=false
PRIMARY_REGION=us-west-2
DR_REGION=us-east-1
ENABLE_SNS=false
ENABLE_SQS=false

DATABASE_URL=sqlite+aiosqlite:///./data/streamvault.db
JWT_SECRET=change-me-for-demo

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# EC2 + ALB (browser or tools hitting the API from the internet)
# Bind the process on all interfaces; match the ALB target group port (often 8000).
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS: list every origin that will call the API (your frontend URL, or http://localhost:5173 for local UI).
# For an ALB DNS name use the scheme you actually use (http vs https), e.g.:
# CORS_ORIGINS=https://your-app.example.com,https://streamvault-alb-123.us-west-2.elb.amazonaws.com

# After training (see docs/RUN_INSTRUCTIONS.md)
ML_MODEL_PATH=services/ml_predictor/models/ed_lstm_demo.keras

# Optional standalone ML service
ML_USE_STANDALONE_SERVICE=false
ML_SERVICE_URL=http://127.0.0.1:8001

# Freeze ML input for repeatable demos: normal | high_cpu (see data/demo_windows/predefined_windows.json)
# ML_DEMO_WINDOW_PRESET=normal

# Local ED-LSTM sensitivity (when ML_MODEL_PATH exists): lower k = more anomalies; min_history = prediction runs before gate clears
# ML_ANOMALY_K_SIGMA=2.5
# ML_ANOMALY_MIN_HISTORY=3

# Use SageMaker endpoint for inference on AWS (see docs/SAGEMAKER_ENDPOINT.md)
ML_USE_SAGEMAKER=false
